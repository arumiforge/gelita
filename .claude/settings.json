{
  "env": {
    "GIT_AUTHOR_NAME": "Arumi Studios",
    "GIT_AUTHOR_EMAIL": "arumiforge@gmail.com",
    "GIT_COMMITTER_NAME": "Arumi Studios",
    "GIT_COMMITTER_EMAIL": "arumiforge@gmail.com"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": ["SearchPlugins", "SuggestPluginInstall"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/before-bash.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder (.claude/rules/language.md): reply to the owner in English even if they wrote in Indonesian. Code, comments, commits, and agent prompts in English; user-facing UI text in friendly Indonesian.'"
          }
        ]
      }
    ]
  }
}
