{
    "name": "gelita/gelita",
    "description": "GELITA — Game Edukasi Literasi dan Etnopedagogi Kedu (CodeIgniter 4)",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "mpdf/mpdf": "^8.3",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "gelita-dependency-notes": {
            "codeigniter4/framework": "framework aplikasi",
            "phpoffice/phpspreadsheet": "export XLSX multi-sheet untuk SPSS/R dan impor workbook bank soal",
            "mpdf/mpdf": "export PDF laporan HTML/CSS berbahasa Indonesia",
            "_batas": "v1 dibatasi tiga paket produksi ini; paket baru wajib diberi alasan di sini"
        }
    }
}
